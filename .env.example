# Copiati acest fisier in .env.local si completati valorile

# Baza de date Postgres (Supabase). Pe Vercel se completeaza automat de integrarea Supabase.
# Local: Postgres propriu sau "Connection string" din Supabase -> Project Settings -> Database.
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/crm_lux_store

# Secret pentru sesiuni (sir lung, aleator)
JWT_SECRET=schimba-acest-secret-cu-unul-aleator-lung

# Contul de administrator creat la prima pornire
SEED_ADMIN_EMAIL=admin@crm.local
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Administrator

# Optional: cheie API "master" (pe langa cheile create din Integrari -> API)
CRM_API_KEY=

# Optional: protejeaza sincronizarea zilnica /api/cron/sync (Vercel o trimite automat)
CRON_SECRET=
