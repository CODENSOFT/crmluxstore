// =====================================================================================
//  ОбменСLuxStoreCRM — общий модуль (Сервер, Вызов сервера: нет, Привилегированный: да)
//  Прямой обмен 1С <-> Lux Store CRM по HTTPS (REST/JSON), без внешних сервисов.
//
//  Направления:
//    1С  -> CRM : номенклатура, группы, склады, цены, остатки, контрагенты, индивидуальные цены,
//                 поступления, перемещения, списания, оплаты заказов, подтверждение выгрузки заказов.
//    CRM -> 1С  : ВСЁ, что изменилось в CRM (товары, клиенты, заказы с оплатами, остатки, документы)
//                 через «ленту изменений» GET /api/v1/changes?after=<курсор>.
//
//  Установка:
//    1. Создайте общий модуль «ОбменСLuxStoreCRM» и вставьте этот код.
//    2. В CRM: Интеграции -> API и ключи -> Новый ключ, тип «1С». Скопируйте ключ (показывается один раз).
//    3. Один раз выполните: ОбменСLuxStoreCRM.НастроитьПодключение("https://<адрес-crm>", "<ключ>");
//    4. Первичная загрузка: ОбменСLuxStoreCRM.ПервичнаяВыгрузка();
//    5. Регламентное задание (каждые 5–15 минут) -> ОбменСLuxStoreCRM.ВыполнитьОбмен();
//
//  Места, зависящие от конфигурации (УТ 11 / БП 3.0 / версии для Молдовы), помечены «АДАПТИРУЙТЕ».
//  Документация: <адрес-crm>/docs/INTEGRARE-1C.md, спецификация: <адрес-crm>/api/v1/openapi.json
// =====================================================================================

#Область НастройкиПодключения

Процедура НастроитьПодключение(Адрес, КлючAPI) Экспорт
	Настройки = Новый Структура("Адрес, Ключ", СокрЛП(Адрес), СокрЛП(КлючAPI));
	ХранилищеОбщихНастроек.Сохранить("LuxStoreCRM", "Подключение", Настройки);
	Ответ = ВызватьAPI("GET", "/ping");
	Сообщить("Подключение к Lux Store CRM: " + ?(Ответ.Успех, "OK (ключ «" + Ответ.Данные.Получить("key") + "»)", "ОШИБКА: " + Ответ.Ошибка));
КонецПроцедуры

Функция Подключение()
	Настройки = ХранилищеОбщихНастроек.Загрузить("LuxStoreCRM", "Подключение");
	Если Настройки = Неопределено Тогда
		ВызватьИсключение "Lux Store CRM: не настроено подключение. Выполните НастроитьПодключение(Адрес, Ключ).";
	КонецЕсли;
	Возврат Настройки;
КонецФункции

Функция ТекущийКурсор()
	Курсор = ХранилищеОбщихНастроек.Загрузить("LuxStoreCRM", "Курсор");
	Возврат ?(Курсор = Неопределено, 0, Курсор);
КонецФункции

Процедура СохранитьКурсор(Курсор)
	ХранилищеОбщихНастроек.Сохранить("LuxStoreCRM", "Курсор", Курсор);
КонецПроцедуры

#КонецОбласти

#Область HTTP

// Возвращает Структура: Успех (Булево), КодСостояния, Данные (Соответствие/Массив), Мета, Ошибка
Функция ВызватьAPI(Метод, Путь, Тело = Неопределено) Экспорт
	Настройки = Подключение();
	Структура = РазобратьАдрес(Настройки.Адрес);
	Защищенное = ?(Структура.Схема = "https", Новый ЗащищенноеСоединениеOpenSSL(), Неопределено);
	Соединение = Новый HTTPСоединение(Структура.Хост, Структура.Порт, , , , 60, Защищенное);

	Запрос = Новый HTTPЗапрос("/api/v1" + Путь);
	Запрос.Заголовки.Вставить("X-API-Key", Настройки.Ключ);
	Запрос.Заголовки.Вставить("Accept", "application/json");
	Если Тело <> Неопределено Тогда
		Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
		Запрос.УстановитьТелоИзСтроки(ВJSON(Тело), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	КонецЕсли;

	Результат = Новый Структура("Успех, КодСостояния, Данные, Мета, Ошибка", Ложь, 0, Неопределено, Неопределено, "");
	Попытка
		Ответ = Соединение.ВызватьHTTPМетод(Метод, Запрос);
	Исключение
		Результат.Ошибка = "Нет связи с CRM: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ЗаписьЖурналаРегистрации("LuxStoreCRM", УровеньЖурналаРегистрации.Ошибка, , , Результат.Ошибка);
		Возврат Результат;
	КонецПопытки;

	Результат.КодСостояния = Ответ.КодСостояния;
	Текст = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Если ПустаяСтрока(Текст) Тогда
		Результат.Ошибка = "Пустой ответ CRM (HTTP " + Ответ.КодСостояния + ")";
		Возврат Результат;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Текст);
	Данные = ПрочитатьJSON(Чтение, Истина);
	Результат.Успех = (Данные.Получить("ok") = Истина);
	Результат.Данные = Данные.Получить("data");
	Результат.Мета = Данные.Получить("meta");
	Если Не Результат.Успех Тогда
		Результат.Ошибка = Строка(Данные.Получить("error"));
		ЗаписьЖурналаРегистрации("LuxStoreCRM", УровеньЖурналаРегистрации.Предупреждение, , ,
			Метод + " " + Путь + ": " + Результат.Ошибка);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция РазобратьАдрес(Адрес)
	Схема = ?(СтрНачинаетсяС(НРег(Адрес), "http://"), "http", "https");
	Хост = СтрЗаменить(СтрЗаменить(Адрес, "https://", ""), "http://", "");
	Если СтрНайти(Хост, "/") > 0 Тогда
		Хост = Лев(Хост, СтрНайти(Хост, "/") - 1);
	КонецЕсли;
	Порт = ?(Схема = "https", 443, 80);
	Если СтрНайти(Хост, ":") > 0 Тогда
		Порт = Число(Сред(Хост, СтрНайти(Хост, ":") + 1));
		Хост = Лев(Хост, СтрНайти(Хост, ":") - 1);
	КонецЕсли;
	Возврат Новый Структура("Схема, Хост, Порт", Схема, Хост, Порт);
КонецФункции

Функция ВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Нет));
	ЗаписатьJSON(Запись, Значение, Новый НастройкиСериализацииJSON);
	Возврат Запись.Закрыть();
КонецФункции

Функция ДатаISO(Дата)
	Возврат Формат(УниверсальноеВремя(Дата), "ДФ=yyyy-MM-ddTHH:mm:ss") + "Z";
КонецФункции

Функция ИзISO(Строка)
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат Дата(1, 1, 1);
	КонецЕсли;
	Возврат МестноеВремя(XMLЗначение(Тип("Дата"), Лев(Строка, 19)));
КонецФункции

Функция УИД(Ссылка)
	Возврат Строка(Ссылка.УникальныйИдентификатор());
КонецФункции

#КонецОбласти

#Область ТочкиВхода

// Регламентное задание: полный цикл обмена (каждые 5–15 минут)
Процедура ВыполнитьОбмен() Экспорт
	ОтправитьИзменённуюНоменклатуру();
	ПолучитьИзмененияИзCRM();
	ОтправитьОплаты();
	// Остатки НЕ перезаписываются при каждом обмене: оперативный остаток ведёт CRM (продажи в реальном времени).
	// ОтправитьОстатки() — только при первичной загрузке и после инвентаризации / сверки.
КонецПроцедуры

// Первый запуск: всё из 1С отправляется в CRM, затем курсор ставится на «сейчас»
Процедура ПервичнаяВыгрузка() Экспорт
	ОтправитьСклады();
	ОтправитьГруппы();
	ОтправитьНоменклатуру(Неопределено);
	ОтправитьКонтрагентов(Неопределено);
	ОтправитьОстатки();
	Ответ = ВызватьAPI("GET", "/changes/cursor");
	Если Ответ.Успех Тогда
		СохранитьКурсор(Ответ.Данные.Получить("cursor"));
	КонецЕсли;
	Сообщить("Первичная выгрузка в Lux Store CRM завершена.");
КонецПроцедуры

#КонецОбласти

#Область Отправка1СвCRM

Процедура ОтправитьСклады() Экспорт
	Пакет = Новый Массив;
	Выборка = Справочники.Склады.Выбрать(); // АДАПТИРУЙТЕ: имя справочника складов
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Или Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Пакет.Добавить(Новый Структура("externalId, code, name", УИД(Выборка.Ссылка), СокрЛП(Выборка.Код), Выборка.Наименование));
	КонецЦикла;
	Если Пакет.Количество() Тогда
		ВызватьAPI("POST", "/warehouses", Новый Структура("items", Пакет));
	КонецЕсли;
КонецПроцедуры

Процедура ОтправитьГруппы() Экспорт
	Пакет = Новый Массив;
	Выборка = Справочники.Номенклатура.Выбрать(); // АДАПТИРУЙТЕ: или Справочники.ВидыНоменклатуры / ТоварныеКатегории
	Пока Выборка.Следующий() Цикл
		Если Не Выборка.ЭтоГруппа Или Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Группа = Новый Структура("externalId, name", УИД(Выборка.Ссылка), Выборка.Наименование);
		Если ЗначениеЗаполнено(Выборка.Родитель) Тогда
			Группа.Вставить("parentExternalId", УИД(Выборка.Родитель));
		КонецЕсли;
		Пакет.Добавить(Группа);
	КонецЦикла;
	Если Пакет.Количество() Тогда
		ВызватьAPI("POST", "/categories", Новый Структура("items", Пакет));
	КонецЕсли;
КонецПроцедуры

// Номенклатура: если ИзмененныеСсылки = Неопределено — отправляется весь справочник (пакетами по 500)
Процедура ОтправитьНоменклатуру(ИзмененныеСсылки) Экспорт
	Пакет = Новый Массив;
	Если ИзмененныеСсылки = Неопределено Тогда
		Выборка = Справочники.Номенклатура.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если Не Выборка.ЭтоГруппа Тогда
				Пакет.Добавить(ДанныеТовара(Выборка.Ссылка));
			КонецЕсли;
			Если Пакет.Количество() = 500 Тогда
				ОтправитьПакетТоваров(Пакет);
				Пакет = Новый Массив;
			КонецЕсли;
		КонецЦикла;
	Иначе
		Для Каждого Ссылка Из ИзмененныеСсылки Цикл
			Пакет.Добавить(ДанныеТовара(Ссылка));
		КонецЦикла;
	КонецЕсли;
	Если Пакет.Количество() Тогда
		ОтправитьПакетТоваров(Пакет);
	КонецЕсли;
КонецПроцедуры

Процедура ОтправитьПакетТоваров(Пакет)
	Ответ = ВызватьAPI("POST", "/products", Новый Структура("items", Пакет));
	Если Ответ.Успех И Ответ.Данные.Получить("errors") > 0 Тогда
		Для Каждого Строка Из Ответ.Данные.Получить("results") Цикл
			Если Строка.Получить("status") = "error" Тогда
				ЗаписьЖурналаРегистрации("LuxStoreCRM", УровеньЖурналаРегистрации.Предупреждение, , ,
					"Товар " + Строка.Получить("sku") + ": " + Строка.Получить("error"));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

// АДАПТИРУЙТЕ: реквизиты номенклатуры и получение цен под вашу конфигурацию
Функция ДанныеТовара(Ссылка) Экспорт
	Товар = Новый Структура;
	Товар.Вставить("externalId", УИД(Ссылка));
	Товар.Вставить("name", Ссылка.Наименование);
	Товар.Вставить("sku", СокрЛП(Ссылка.Артикул));
	Товар.Вставить("active", Не Ссылка.ПометкаУдаления);
	Если ЗначениеЗаполнено(Ссылка.Родитель) Тогда
		Товар.Вставить("categoryExternalId", УИД(Ссылка.Родитель));
	КонецЕсли;
	// Штрихкод (УТ 11: РегистрСведений.ШтрихкодыНоменклатуры)
	ШК = ШтрихкодТовара(Ссылка);
	Если ЗначениеЗаполнено(ШК) Тогда
		Товар.Вставить("barcode", ШК);
	КонецЕсли;
	// Цены: розница / опт / закупка (с НДС, в MDL)
	Товар.Вставить("price", ЦенаТовара(Ссылка, "Розничная"));
	ЦенаОпт = ЦенаТовара(Ссылка, "Оптовая");
	Если ЦенаОпт > 0 Тогда
		Товар.Вставить("wholesalePrice", ЦенаОпт);
	КонецЕсли;
	ЦенаЗакуп = ЦенаТовара(Ссылка, "Закупочная");
	Если ЦенаЗакуп > 0 Тогда
		Товар.Вставить("costPrice", ЦенаЗакуп);
	КонецЕсли;
	// Единица: bucata | litri | kg | metru | set | pachet | pereche
	Товар.Вставить("unit", ЕдиницаДляCRM(Ссылка));
	Возврат Товар;
КонецФункции

Функция ШтрихкодТовара(Ссылка)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1 Ш.Штрихкод КАК Штрихкод
	|ИЗ РегистрСведений.ШтрихкодыНоменклатуры КАК Ш
	|ГДЕ Ш.Номенклатура = &Ссылка");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), Выборка.Штрихкод, "");
	Исключение
		Возврат ""; // в конфигурации нет такого регистра
	КонецПопытки;
КонецФункции

// АДАПТИРУЙТЕ: УТ 11 — РегистрСведений.ЦеныНоменклатуры, вид цены по наименованию
Функция ЦенаТовара(Ссылка, ИмяВидаЦены)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ Ц.Цена КАК Цена
	|ИЗ РегистрСведений.ЦеныНоменклатуры.СрезПоследних(, Номенклатура = &Ссылка) КАК Ц
	|ГДЕ Ц.ВидЦены.Наименование ПОДОБНО &Вид");
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Вид", "%" + ИмяВидаЦены + "%");
	Попытка
		Выборка = Запрос.Выполнить().Выбрать();
		Возврат ?(Выборка.Следующий(), Выборка.Цена, 0);
	Исключение
		Возврат 0;
	КонецПопытки;
КонецФункции

Функция ЕдиницаДляCRM(Ссылка)
	Ед = НРег(Строка(Ссылка.ЕдиницаИзмерения));
	Если СтрНайти(Ед, "л") = 1 Тогда
		Возврат "litri";
	ИначеЕсли СтрНайти(Ед, "кг") > 0 Тогда
		Возврат "kg";
	ИначеЕсли Ед = "м" Или СтрНайти(Ед, "метр") > 0 Тогда
		Возврат "metru";
	ИначеЕсли СтрНайти(Ед, "компл") > 0 Или СтрНайти(Ед, "набор") > 0 Тогда
		Возврат "set";
	ИначеЕсли СтрНайти(Ед, "уп") > 0 Тогда
		Возврат "pachet";
	ИначеЕсли СтрНайти(Ед, "пар") > 0 Тогда
		Возврат "pereche";
	КонецЕсли;
	Возврат "bucata";
КонецФункции

// Отправка только изменённой номенклатуры. Рекомендуется план обмена «ОбменСLuxStoreCRM»
// с авторегистрацией справочника Номенклатура. Если плана обмена нет — раз в сутки полная выгрузка.
Процедура ОтправитьИзменённуюНоменклатуру() Экспорт
	Если Метаданные.ПланыОбмена.Найти("ОбменСLuxStoreCRM") = Неопределено Тогда
		Последняя = ХранилищеОбщихНастроек.Загрузить("LuxStoreCRM", "ПолнаяВыгрузкаТоваров");
		Если Последняя = Неопределено Или ТекущаяДатаСеанса() - Последняя > 86400 Тогда
			ОтправитьНоменклатуру(Неопределено);
			ХранилищеОбщихНастроек.Сохранить("LuxStoreCRM", "ПолнаяВыгрузкаТоваров", ТекущаяДатаСеанса());
		КонецЕсли;
		Возврат;
	КонецЕсли;
	Узел = ПланыОбмена["ОбменСLuxStoreCRM"].ЭтотУзел(); // АДАПТИРУЙТЕ: используйте узел CRM, а не ЭтотУзел
	Выборка = ПланыОбмена.ВыбратьИзменения(Узел, 1);
	Ссылки = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Данные = Выборка.Получить();
		Если ТипЗнч(Данные) = Тип("СправочникОбъект.Номенклатура") И Не Данные.ЭтоГруппа Тогда
			Ссылки.Добавить(Данные.Ссылка);
		КонецЕсли;
	КонецЦикла;
	Если Ссылки.Количество() Тогда
		ОтправитьНоменклатуру(Ссылки);
	КонецЕсли;
	ПланыОбмена.УдалитьРегистрациюИзменений(Узел, 1);
КонецПроцедуры

// Остатки: 1С — источник истины, режим set (абсолютное количество по складу)
Процедура ОтправитьОстатки() Экспорт
	Запрос = Новый Запрос(
	"ВЫБРАТЬ О.Номенклатура КАК Номенклатура, О.Склад КАК Склад, СУММА(О.ВНаличииОстаток) КАК Количество
	|ИЗ РегистрНакопления.ТоварыНаСкладах.Остатки КАК О
	|СГРУППИРОВАТЬ ПО О.Номенклатура, О.Склад"); // АДАПТИРУЙТЕ: регистр остатков вашей конфигурации
	Пакет = Новый Массив;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Пакет.Добавить(Новый Структура("productExternalId, warehouseExternalId, quantity",
			УИД(Выборка.Номенклатура), УИД(Выборка.Склад), Выборка.Количество));
		Если Пакет.Количество() = 1000 Тогда
			ВызватьAPI("POST", "/stock", Новый Структура("mode, items", "set", Пакет));
			Пакет = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() Тогда
		ВызватьAPI("POST", "/stock", Новый Структура("mode, items", "set", Пакет));
	КонецЕсли;
КонецПроцедуры

// АДАПТИРУЙТЕ: реквизиты контрагентов (ИНН/IDNO, телефон из контактной информации)
Процедура ОтправитьКонтрагентов(ИзмененныеСсылки) Экспорт
	Пакет = Новый Массив;
	Выборка = Справочники.Контрагенты.Выбрать();
	Пока Выборка.Следующий() Цикл
		Если Выборка.ЭтоГруппа Или Выборка.ПометкаУдаления Тогда
			Продолжить;
		КонецЕсли;
		Если ИзмененныеСсылки <> Неопределено И ИзмененныеСсылки.Найти(Выборка.Ссылка) = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Клиент = Новый Структура;
		Клиент.Вставить("externalId", УИД(Выборка.Ссылка));
		Клиент.Вставить("name", Выборка.Наименование);
		Клиент.Вставить("type", "company"); // АДАПТИРУЙТЕ: ЮрФизЛицо
		Клиент.Вставить("idno", СокрЛП(Выборка.ИНН));
		Пакет.Добавить(Клиент);
		Если Пакет.Количество() = 500 Тогда
			ВызватьAPI("POST", "/customers", Новый Структура("items", Пакет));
			Пакет = Новый Массив;
		КонецЕсли;
	КонецЦикла;
	Если Пакет.Количество() Тогда
		ВызватьAPI("POST", "/customers", Новый Структура("items", Пакет));
	КонецЕсли;
КонецПроцедуры

// Индивидуальные цены клиента (соглашение / договор): replace — заменить весь список
Процедура ОтправитьЦеныКлиента(Контрагент, ТаблицаЦен) Экспорт
	Пакет = Новый Массив;
	Для Каждого Строка Из ТаблицаЦен Цикл // колонки: Номенклатура, Цена
		Пакет.Добавить(Новый Структура("productExternalId, price", УИД(Строка.Номенклатура), Строка.Цена));
	КонецЦикла;
	ВызватьAPI("POST", "/customers/" + УИД(Контрагент) + "/prices", Новый Структура("mode, items", "replace", Пакет));
КонецПроцедуры

// Поступление товаров (ПриходнаяНакладная / ПоступлениеТоваровУслуг) -> «Recepție» в CRM
Процедура ОтправитьПоступление(Документ) Экспорт
	Строки = Новый Массив;
	Для Каждого Стр Из Документ.Товары Цикл
		Строки.Добавить(Новый Структура("productExternalId, quantity, unitCost", УИД(Стр.Номенклатура), Стр.Количество, Стр.Цена));
	КонецЦикла;
	Тело = Новый Структура;
	Тело.Вставить("externalId", УИД(Документ.Ссылка));
	Тело.Вставить("warehouseExternalId", УИД(Документ.Склад));
	Тело.Вставить("supplierExternalId", УИД(Документ.Контрагент));
	Тело.Вставить("supplierInvoice", Документ.Номер);
	Тело.Вставить("supplierInvoiceDate", ДатаISO(Документ.Дата));
	Тело.Вставить("items", Строки);
	ВызватьAPI("POST", "/arrivals", Тело); // повторная отправка безопасна: тот же externalId -> без дублей
КонецПроцедуры

// Оплаты по заказам CRM. АДАПТИРУЙТЕ: выбор документов оплаты и связь с заказом (номер CMD-xxxxx)
Процедура ОтправитьОплаты() Экспорт
	// Пример: для каждого нового ПКО / ПоступленияБезналичных с основанием «заказ CRM»:
