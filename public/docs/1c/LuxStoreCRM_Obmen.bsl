КонецПроцедуры

#КонецОбласти

#Область ПолучениеИзCRM

// Лента изменений CRM: всё, что изменилось после курсора. Свои же отправки 1С сюда не возвращаются.
Процедура ПолучитьИзмененияИзCRM() Экспорт
	Курсор = ТекущийКурсор();
	ЕстьЕщё = Истина;
	Пока ЕстьЕщё Цикл
		Ответ = ВызватьAPI("GET", "/changes?after=" + Формат(Курсор, "ЧГ=0") + "&limit=200");
		Если Не Ответ.Успех Тогда
			Прервать;
		КонецЕсли;
		Для Каждого Изменение Из Ответ.Данные Цикл
			Попытка
				ОбработатьИзменение(Изменение);
			Исключение
				// ошибка одного объекта не останавливает обмен; объект придёт снова при следующем изменении
				ЗаписьЖурналаРегистрации("LuxStoreCRM", УровеньЖурналаРегистрации.Ошибка, , ,
					Изменение.Получить("entity") + " " + Изменение.Получить("id") + ": " + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			КонецПопытки;
		КонецЦикла;
		Курсор = Ответ.Мета.Получить("cursor");
		ЕстьЕщё = Ответ.Мета.Получить("hasMore") = Истина;
		СохранитьКурсор(Курсор);
		ВызватьAPI("POST", "/changes/ack", Новый Структура("cursor", Курсор)); // CRM показывает, что 1С в актуальном состоянии
	КонецЦикла;
КонецПроцедуры

Процедура ОбработатьИзменение(Изменение)
	Сущность = Изменение.Получить("entity");
	Данные = Изменение.Получить("data");
	Если Изменение.Получить("op") = "delete" Или Данные = Неопределено Тогда
		Возврат; // объект удалён в CRM — в 1С ничего не удаляем автоматически
	КонецЕсли;
	Если Сущность = "order" Тогда
		ЗагрузитьЗаказ(Данные);
	ИначеЕсли Сущность = "customer" Тогда
		ЗагрузитьКлиента(Данные);
	ИначеЕсли Сущность = "product" Тогда
		ЗагрузитьТовар(Данные);
	КонецЕсли;
	// Остальные сущности (stock, arrival, transfer, writeoff, inventory, category, warehouse, supplier)
	// приходят в том же формате — подключите обработчики по необходимости.
КонецПроцедуры

// Товар, созданный в CRM (без externalId), создаётся в 1С; в CRM записывается UUID из 1С
Процедура ЗагрузитьТовар(Данные)
	Если ЗначениеЗаполнено(Данные.Получить("externalId")) Тогда
		Возврат; // товар уже связан с 1С (мастер — 1С)
	КонецЕсли;
	Объект = Справочники.Номенклатура.СоздатьЭлемент();
	Объект.Наименование = Данные.Получить("name");
	Объект.Артикул = ?(Данные.Получить("sku") = Неопределено, "", Данные.Получить("sku"));
	// АДАПТИРУЙТЕ: обязательные реквизиты (ВидНоменклатуры, ЕдиницаИзмерения, СтавкаНДС ...)
	Объект.ОбменДанными.Загрузка = Истина; // не регистрировать изменение обратно в CRM
	Объект.Записать();
	ВызватьAPI("POST", "/products", Новый Структура("items",
		ОбщегоНазначенияКлиентСервер_Массив(Новый Структура("id, externalId", Данные.Получить("id"), УИД(Объект.Ссылка)))));
КонецПроцедуры

// Клиент из CRM (магазин, сайт, Telegram) -> Контрагенты
Процедура ЗагрузитьКлиента(Данные)
	Ссылка = НайтиПоUUID(Справочники.Контрагенты, Данные.Получить("externalId"));
	Если Ссылка = Неопределено Тогда
		Объект = Справочники.Контрагенты.СоздатьЭлемент();
	Иначе
		Объект = Ссылка.ПолучитьОбъект();
	КонецЕсли;
	Объект.Наименование = Данные.Получить("name");
	Если ЗначениеЗаполнено(Данные.Получить("idno")) Тогда
		Объект.ИНН = Данные.Получить("idno"); // АДАПТИРУЙТЕ
	КонецЕсли;
	Объект.ОбменДанными.Загрузка = Истина;
	Объект.Записать();
	Если Ссылка = Неопределено Тогда
		ВызватьAPI("POST", "/customers", Новый Структура("items",
			ОбщегоНазначенияКлиентСервер_Массив(Новый Структура("id, externalId", Данные.Получить("id"), УИД(Объект.Ссылка)))));
	КонецЕсли;
КонецПроцедуры

// Заказ CRM -> ЗаказКлиента (УТ 11) или РеализацияТоваровУслуг. Создаётся, когда заказ подтверждён.
Процедура ЗагрузитьЗаказ(Данные)
	Статус = Данные.Получить("status");
	Если Статус = "new" Или Статус = "pending_approval" Или Статус = "rejected" Тогда
		Возврат; // ещё не подтверждён в CRM
	КонецЕсли;
	Экспорт1С = Данные.Получить("export1c");
	Если Экспорт1С.Получить("exported") = Истина И Статус <> "cancelled" Тогда
		Возврат; // уже создан в 1С; при необходимости обновите документ по docId
	КонецЕсли;
	Если Статус = "cancelled" Тогда
		Возврат; // АДАПТИРУЙТЕ: пометить на удаление документ по Экспорт1С.docId
	КонецЕсли;

	Документ = Документы.ЗаказКлиента.СоздатьДокумент(); // АДАПТИРУЙТЕ
	Документ.Дата = ИзISO(Данные.Получить("createdAt"));
	Клиент = Данные.Получить("customer");
	Если Клиент <> Неопределено И ЗначениеЗаполнено(Клиент.Получить("externalId")) Тогда
		Документ.Контрагент = НайтиПоUUID(Справочники.Контрагенты, Клиент.Получить("externalId"));
	КонецЕсли;
	Документ.Комментарий = "Lux Store CRM " + Данные.Получить("number");
	Для Каждого Строка Из Данные.Получить("items") Цикл
		Стр = Документ.Товары.Добавить();
		Стр.Номенклатура = НайтиПоUUID(Справочники.Номенклатура, Строка.Получить("productExternalId"));
		Стр.Количество = Строка.Получить("quantity");
		Стр.Цена = Строка.Получить("unitPrice");
		Стр.ПроцентРучнойСкидки = Строка.Получить("discount"); // АДАПТИРУЙТЕ
		Стр.Сумма = Строка.Получить("lineTotal");
	КонецЦикла;
	Документ.ОбменДанными.Загрузка = Истина;
	Документ.Записать(РежимЗаписиДокумента.Запись);

	// Сообщаем CRM номер документа 1С — заказ отмечается как «выгружен в 1С»
	ВызватьAPI("POST", "/orders/" + Данные.Получить("id") + "/export",
		Новый Структура("docNumber, docId", Документ.Номер, УИД(Документ.Ссылка)));
КонецПроцедуры

Функция НайтиПоUUID(Менеджер, Строка)
	Если Не ЗначениеЗаполнено(Строка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Ссылка = Менеджер.ПолучитьСсылку(Новый УникальныйИдентификатор(Строка));
		Возврат ?(ПустаяСтрока(Ссылка.ВерсияДанных), Неопределено, Ссылка);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ОбщегоНазначенияКлиентСервер_Массив(Элемент)
	Массив = Новый Массив;
	Массив.Добавить(Элемент);
	Возврат Массив;
КонецФункции

#КонецОбласти
